{
  // =============================================================================
  // WASM-4 Snake - VSCode Settings
  // =============================================================================
  // This file configures VSCode for both Rust (WASM-4) and Web (Astro) development
  // =============================================================================

  // ---------------------------------------------------------------------------
  // Rust Analyzer Settings (WASM-4 Game)
  // ---------------------------------------------------------------------------
  "rust-analyzer.cargo.target": "wasm32-unknown-unknown",
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--target", "wasm32-unknown-unknown"],

  // ---------------------------------------------------------------------------
  // Editor: Format on Save
  // ---------------------------------------------------------------------------
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Language-specific formatters
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // ---------------------------------------------------------------------------
  // File Associations
  // ---------------------------------------------------------------------------
  "files.associations": {
    "*.wasm": "wasm",
    "*.astro": "astro"
  },

  // ---------------------------------------------------------------------------
  // File Exclusions (hide from explorer and search)
  // ---------------------------------------------------------------------------
  "files.exclude": {
    "target": true,
    "web/dist": true,
    "web/node_modules": true,
    "**/*.wasm": true
  },
  "search.exclude": {
    "target": true,
    "web/dist": true,
    "web/node_modules": true,
    "Cargo.lock": true,
    "web/pnpm-lock.yaml": true
  },

  // ---------------------------------------------------------------------------
  // Terminal Environment
  // ---------------------------------------------------------------------------
  "terminal.integrated.env.osx": {
    "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
  },
  "terminal.integrated.env.linux": {
    "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
  },

  // ---------------------------------------------------------------------------
  // Task Runner
  // ---------------------------------------------------------------------------
  "task.autoDetect": "on",

  // ---------------------------------------------------------------------------
  // TypeScript (Astro) - Use local version
  // ---------------------------------------------------------------------------
  "typescript.tsdk": "web/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ---------------------------------------------------------------------------
  // ESLint - Use local version
  // ---------------------------------------------------------------------------
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": ["web"],
  "eslint.options": {
    "overrideConfigFile": "web/eslint.config.js"
  },
  "eslint.nodePath": "web/node_modules",
  "eslint.validate": ["javascript", "typescript", "astro"],

  // ---------------------------------------------------------------------------
  // Prettier - Use local version
  // ---------------------------------------------------------------------------
  "prettier.prettierPath": "web/node_modules/prettier",
  "prettier.configPath": "web/.prettierrc",
  "prettier.ignorePath": "web/.prettierignore",

  // ---------------------------------------------------------------------------
  // Astro Settings
  // ---------------------------------------------------------------------------
  "astro.content-intellisense": true,
  "astro.typescript.tsdk": "web/node_modules/typescript/lib",

  // ---------------------------------------------------------------------------
  // Emmet (for HTML/Astro templates)
  // ---------------------------------------------------------------------------
  "emmet.includeLanguages": {
    "astro": "html"
  },

  // ---------------------------------------------------------------------------
  // CSS Settings
  // ---------------------------------------------------------------------------
  "css.validate": true,
  "css.lint.unknownAtRules": "ignore"
}
