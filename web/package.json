{
  "name": "wasm4-snake-web",
  "type": "module",
  "version": "1.0.0",
  "description": "Landing page for WASM-4 Snake game",
  "author": "VdustR (ViPro)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VdustR/wasm4-snake.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.1",
      "nanoid@<3.3.12": "3.3.18",
      "postcss": "8.5.26"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check"
  },
  "dependencies": {
    "@iconify-json/pixelarticons": "^1.2.9",
    "astro": "^7.2.10",
    "astro-icon": "^1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
