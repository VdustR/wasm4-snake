---
import { Icon } from 'astro-icon/components';

interface Props {
  width?: number;
  height?: number;
}

const { width = 320, height = 320 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="game-wrapper">
  <div class="game-container scanlines" id="game-container">
    <iframe
      id="game-frame"
      src={`${base}/game/index.html`}
      width={width}
      height={height}
      title="WASM-4 Snake Game"
      allowfullscreen
      allow="gamepad; fullscreen"></iframe>
    <!-- 8-bit style fullscreen overlay button -->
    <button id="fullscreen-btn" class="fullscreen-overlay-btn" title="Toggle Fullscreen">
      <Icon name="pixelarticons:expand" class="icon-expand" />
      <Icon name="pixelarticons:collapse" class="icon-collapse" />
    </button>
  </div>
  <p class="game-hint">Click to focus, then use arrow keys to play</p>
</div>

<script>
  const container = document.getElementById('game-container');
  const btn = document.getElementById('fullscreen-btn');
  const iframe = document.getElementById('game-frame') as HTMLIFrameElement;

  // Cross-browser fullscreen helpers
  function isFullscreen(): boolean {
    return !!(
      document.fullscreenElement ||
      (document as any).webkitFullscreenElement ||
      (document as any).mozFullScreenElement ||
      (document as any).msFullscreenElement
    );
  }

  function requestFullscreen(el: HTMLElement): void {
    if (el.requestFullscreen) {
      el.requestFullscreen();
    } else if ((el as any).webkitRequestFullscreen) {
      (el as any).webkitRequestFullscreen();
    } else if ((el as any).mozRequestFullScreen) {
      (el as any).mozRequestFullScreen();
    } else if ((el as any).msRequestFullscreen) {
      (el as any).msRequestFullscreen();
    }
  }

  function exitFullscreen(): void {
    if (document.exitFullscreen) {
      document.exitFullscreen();
    } else if ((document as any).webkitExitFullscreen) {
      (document as any).webkitExitFullscreen();
    } else if ((document as any).mozCancelFullScreen) {
      (document as any).mozCancelFullScreen();
    } else if ((document as any).msExitFullscreen) {
      (document as any).msExitFullscreen();
    }
  }

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!isFullscreen()) {
      if (container) {
        requestFullscreen(container);
      } else if (iframe) {
        requestFullscreen(iframe);
      }
    } else {
      exitFullscreen();
    }
  });

  // Update button state on fullscreen change (all vendor prefixes)
  function updateFullscreenState(): void {
    btn?.classList.toggle('is-fullscreen', isFullscreen());
  }

  document.addEventListener('fullscreenchange', updateFullscreenState);
  document.addEventListener('webkitfullscreenchange', updateFullscreenState);
  document.addEventListener('mozfullscreenchange', updateFullscreenState);
  document.addEventListener('MSFullscreenChange', updateFullscreenState);
</script>

<style>
  .game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .game-container {
    position: relative;
  }

  .game-container iframe {
    display: block;
    border: none;
    background-color: var(--color-bg);
  }

  /* 8-bit style fullscreen overlay button */
  .fullscreen-overlay-btn {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 4px solid var(--color-green);
    background-color: rgba(26, 28, 44, 0.75);
    cursor: pointer;
    opacity: 0;
    /* Center icon */
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 0.2s,
      background-color 0.2s,
      border-color 0.2s,
      transform 0.1s;
    z-index: 10;
    box-shadow: 4px 4px 0 rgba(93, 39, 93, 0.8);
  }

  .game-container:hover .fullscreen-overlay-btn,
  .fullscreen-overlay-btn:focus {
    opacity: 1;
  }

  .fullscreen-overlay-btn:hover {
    background-color: rgba(93, 39, 93, 0.9);
    border-color: var(--color-yellow);
  }

  .fullscreen-overlay-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 rgba(93, 39, 93, 0.8);
  }

  .fullscreen-overlay-btn.is-fullscreen {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 56px;
    height: 56px;
    opacity: 0.85;
    animation: pulse-btn 2s ease-in-out infinite;
  }

  .fullscreen-overlay-btn.is-fullscreen:hover {
    opacity: 1;
    animation: none;
  }

  @keyframes pulse-btn {
    0%, 100% {
      opacity: 0.85;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(0.95);
    }
  }

  /* Pixelarticons fullscreen button icons */
  .fullscreen-overlay-btn svg {
    width: 24px;
    height: 24px;
    color: var(--color-green);
    transition: color 0.2s;
  }

  /* Show expand icon by default, hide collapse */
  .fullscreen-overlay-btn .icon-expand {
    display: block;
  }

  .fullscreen-overlay-btn .icon-collapse {
    display: none;
  }

  /* In fullscreen mode, show collapse icon, hide expand */
  .fullscreen-overlay-btn.is-fullscreen .icon-expand {
    display: none;
  }

  .fullscreen-overlay-btn.is-fullscreen .icon-collapse {
    display: block;
    color: var(--color-yellow);
  }

  /* Hover state - change icon color */
  .fullscreen-overlay-btn:hover svg {
    color: var(--color-yellow);
  }

  .game-hint {
    font-family: var(--font-pixel);
    font-size: 0.625rem;
    color: var(--color-text-muted);
    text-align: center;
    animation: blink 2s infinite;
    margin: 0;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .game-hint {
      animation: none;
    }

    .fullscreen-overlay-btn {
      transition: none;
    }

    .fullscreen-overlay-btn.is-fullscreen {
      animation: none;
    }
  }

  /* Fullscreen styles */
  .game-container:fullscreen {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
  }

  .game-container:fullscreen iframe {
    width: 100vmin;
    height: 100vmin;
    max-width: 100vw;
    max-height: 100vh;
  }

  /* Responsive scaling */
  @media (max-width: 480px) {
    .game-container iframe {
      width: 256px;
      height: 256px;
    }

    .fullscreen-overlay-btn {
      width: 40px;
      height: 40px;
      bottom: 8px;
      right: 8px;
      border-width: 3px;
    }

    .fullscreen-overlay-btn svg {
      width: 18px;
      height: 18px;
    }
  }

  @media (max-width: 320px) {
    .game-container iframe {
      width: 200px;
      height: 200px;
    }
  }
</style>
